# Required
ADMIN_PASSWORD=pick-a-long-password
SECRET_KEY=paste-a-long-random-string
BUSINESS_NAME=Your Consulting Co.
BASE_URL=https://sign.yourdomain.com

# Storage (must be a persistent disk in production)
DATA_DIR=./data
LINK_EXPIRY_DAYS=30
DATE_FORMAT=%b %d, %Y

# Optional email. Leave SMTP_HOST empty to copy signing links yourself.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Your Consulting Co. <sign@yourdomain.com>
ADMIN_EMAIL=you@yourdomain.com
